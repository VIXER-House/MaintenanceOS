# ─────────────────────────────────────────────────────────────
# MaintenanceOS — environment
# Everything except DATABASE_URL is optional. With no keys the app
# runs fully on local mock providers (AI, WhatsApp, speech, vision).
# ─────────────────────────────────────────────────────────────

# PostgreSQL (docker compose up -d starts one with these credentials)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/maintenanceos?schema=public"

# Session signing secret — change in any shared environment (min 32 chars)
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
APP_URL="http://localhost:3000"

# ── Easiest free setup: ONE Google AI Studio key for AI + images + voice ──
# Get it at https://aistudio.google.com/apikey (no card), then set:
#   AI_PROVIDER=gemini  VISION_PROVIDER=gemini  SPEECH_PROVIDER=gemini  GEMINI_API_KEY=...
GEMINI_API_KEY=

# ── AI provider ──────────────────────────────────────────────
# mock | ollama | groq | openrouter | gemini | openai
AI_PROVIDER=mock
AI_API_KEY=
# Optional overrides (sensible defaults per provider)
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_MS=20000
# Let the LLM rephrase WhatsApp replies (facts are still template-injected & verified)
AI_GENERATE_REPLIES=false
# Local Ollama (free): ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

# ── WhatsApp ─────────────────────────────────────────────────
# mock | meta
WHATSAPP_PROVIDER=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=maintenanceos-verify
# Optional: verifies X-Hub-Signature-256 on webhook calls
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# ── Speech-to-text (voice notes) ─────────────────────────────
# mock | gemini (uses GEMINI_API_KEY) | whisper (any OpenAI-compatible /audio/transcriptions endpoint, e.g. Groq)
SPEECH_PROVIDER=mock
# e.g. http://localhost:8000/v1 (faster-whisper-server / speaches) or https://api.groq.com/openai/v1
SPEECH_BASE_URL=
SPEECH_API_KEY=
SPEECH_MODEL=whisper-large-v3-turbo

# ── Vision (image analysis) ──────────────────────────────────
# mock | ollama | gemini | openai
VISION_PROVIDER=mock
VISION_API_KEY=
VISION_MODEL=
VISION_BASE_URL=

# ── Notifications ────────────────────────────────────────────
# Comma list of simulated channels: in_app,whatsapp,sms,email
NOTIFICATION_CHANNELS=in_app

# Local attachment storage
UPLOAD_DIR=./uploads
